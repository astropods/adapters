{
  "name": "@astropods/adapter-ai-sdk",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for the Astro messaging service. Wraps an Agent and auto-wires OpenTelemetry tracing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astropods/adapters.git",
    "directory": "packages/ai-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@astropods/adapter-core": "workspace:*",
    "@astropods/messaging": "latest",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependencies": {
    "ai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "^6.0.0",
    "@types/bun": "^1.3.5",
    "typescript": "^5.3.0",
    "zod": "^4.3.6"
  }
}
